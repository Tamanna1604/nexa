# Copy to .env and edit as needed. All values are optional - these are the defaults.

# ── chat model backend ────────────────────────────────
# "ollama" (local, default) OR an OpenAI-compatible cloud API:
#   groq | cerebras | openrouter | gemini | openai
LLM_BACKEND=ollama

# --- local (LLM_BACKEND=ollama) ---
MODEL_NAME=qwen3:4b
# MODEL_NAME=qwen3:1.7b        # faster on CPU-only machines
# OLLAMA_HOST=http://127.0.0.1:11434

# --- hosted (e.g. LLM_BACKEND=groq) ---
# LLM_BACKEND=groq
# GROQ_API_KEY=gsk_...          # from console.groq.com  (or LLM_API_KEY=...)
# MODEL_NAME=openai/gpt-oss-120b   # check GET /v1/models for what your key can use
# LLM_BASE_URL=                 # only for a provider not in the built-in list

# Qwen3 reasoning: think=true keeps `content` clean. Set false for non-thinking
# models and for every hosted backend.
# LLM_THINK=true
# LLM_NUM_PREDICT=1200          # hard cap on generated tokens
# LLM_TEMPERATURE=0.7

# Embeddings + reranker ALWAYS run locally, regardless of LLM_BACKEND:
EMBEDDING_MODEL=nomic-embed-text
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# ── storage paths ─────────────────────────────────────
# DB_PATH=./memory.db
# CHROMA_PATH=./chroma_db
# DOCUMENTS_DIR=./documents

# ── retrieval tuning ──────────────────────────────────
# DENSE_TOP_K=20
# SPARSE_TOP_K=20
# RRF_K=60
# RERANK_CANDIDATES=40
# FINAL_CONTEXT_N=5
# RERANK_SCORE_FLOOR=0.0

# ── memory ────────────────────────────────────────────
# SHORT_TERM_WINDOW=12
# LONG_TERM_TOP_K=5
# LONG_TERM_MIN_SIMILARITY=0.5  # raise to make Nexa recall memories less eagerly
# MEMORY_DEDUPE_THRESHOLD=0.92
# MEMORY_EXTRACTION=true        # set false to skip the extra LLM call per turn

# ── tools (live data + actions the LLM can call) ──────
# TOOLS_ENABLED=true
# TOOL_MAX_ITERS=4
# TIMEZONE=Asia/Kolkata          # blank = the machine's local timezone
# DEFAULT_LOCATION=Pune          # used by get_weather when you don't name a place
# ALLOW_APP_LAUNCH=true          # open_app + whatsapp + watch (streaming) tools
# EXTRA_APP_ALIASES={"figma": "figma:", "outlook": "outlookmail:"}   # extra name->target
# WEB_SEARCH_ENABLED=true        # web_search tool - DuckDuckGo results as text, keyless
# ALLOW_UI_AUTOMATION=false      # let whatsapp action='send'/'call' drive the WhatsApp window
#                               # (needs: pip install pywinauto)
# BROWSER_AUTOMATION=false       # let `watch` click through to playback itself
#                               # (needs: pip install playwright && playwright install chromium)
# BROWSER_PROFILE_DIR=./.nexa_browser   # Chrome profile for that - log into Netflix/Prime/Hotstar once
# NETFLIX_PROFILE=Tamzy         # which "Who's watching?" profile to pick before playing (blank = first)
# (tools need an OpenAI-compatible backend, e.g. groq - Ollama can't call them yet)

# ── api ───────────────────────────────────────────────
# API_HOST=127.0.0.1
# API_PORT=8000

# ── debug ─────────────────────────────────────────────
# print the full prompt (personality + memories + doc context + history)
# to the terminal before every LLM call
# DEBUG_PROMPT=true
